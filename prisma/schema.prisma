generator client {
  provider = "prisma-client-js"
}

// Postgres, because production runs on Supabase.
//
// SQLite could never have worked in production: Vercel's filesystem is
// read-only outside /tmp and ephemeral per invocation, and prisma/dev.db
// is gitignored, so a deployed build had no database file at all and every
// diagnostic submission would have failed at runtime.
//
// DATABASE_URL is the pooled connection (PgBouncer, port 6543) that the
// application uses at runtime; DIRECT_URL is the direct connection
// (port 5432) that `prisma migrate` needs, because migrations cannot run
// through a transaction pooler. Both are set per environment and never
// committed.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Diagnostic {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // --- Ownership and lifecycle -----------------------------------------
  // Clerk subject id. A STRING, not a uuid: Clerk ids look like
  // "user_2abc..." and do not exist in Supabase's auth.users, so forcing
  // them into a uuid column would fail outright. Null means a guest
  // submission, which stays supported.
  ownerId String?

  // Which version of the question set produced these answers, so a later
  // schema change cannot silently reinterpret an old submission.
  schemaVersion String @default("v1")

  // DRAFT rows are in-progress and owner-visible; SUBMITTED rows are
  // final. Separate from `status`, which is the ADMIN review pipeline and
  // must never be writable by the person who submitted.
  lifecycle String @default("SUBMITTED")

  // Supplied by the client once per submission attempt. Unique, so a
  // double-click or a retry after a timed-out response resolves to the
  // same row instead of creating a second lead.
  idempotencyKey String? @unique

  /// The site language the visitor was reading when they submitted, taken
  /// from the same cookie the language switch sets — not guessed from a
  /// browser header, a country or an email address.
  ///
  /// Recorded so the choice is auditable and a later resend uses the
  /// language they actually chose, rather than whatever the site is set to
  /// by then. Null for submissions from before this existed; those fall
  /// back to the site default (English), which is what they were already
  /// treated as.
  locale         String?

  status          String @default("NEW") // NEW, REVIEWING, REVIEWED, CONTACTED, QUALIFIED, CONVERTED, CLOSED
  statusUpdatedAt DateTime @default(now())

  // Business
  companyName  String
  website      String?
  industry     String
  employees    String
  locations    String
  revenueRange String?

  // Operations
  customerChannels        String // JSON array
  enquiryHandling          String // JSON array
  adminWorkload            String

  /*
   * The two operations questions were rewritten in October 2026 from a
   * 1-5 scale and a Low/Medium/High judgement into plain categorical
   * answers, one of which is explicitly "not sure / not applicable".
   *
   * The legacy columns are KEPT so historical records stay readable with
   * the meaning they were recorded under — a 3 on the old scale still
   * means what it meant. `processStandardization` becomes nullable
   * because the new answer set includes an honest "unknown", and there
   * is no number on a 1-5 scale that means "not answered": writing one
   * would be read downstream as low standardization, which is a
   * negative conclusion the visitor never gave.
   */
  processStandardization   Int?
  keyEmployeeDependency    String

  /** Verbatim new answers. Source of truth for records from Oct 2026 on. */
  taskConsistency          String?
  absenceCoverage          String?

  // Systems
  systems              String // JSON array
  specificTools        String?
  systemConnectivity   String
  spreadsheetDependency String
  automationUsage      String // JSON array

  // Friction
  frictionAreas       String // JSON array
  primaryPainPoint    String
  problemDescription  String
  problemFrequency    String
  impactAreas         String // JSON array

  // Priorities
  primaryInterest String?
  priorities      String // JSON array
  timing          String
  decisionContext String?

  // Contact
  firstName      String
  lastName       String
  email          String
  phone          String?
  role           String?
  privacyConsent Boolean @default(false)

  // Preliminary (computed client-side at submission time, stored as-is)
  preliminaryProfile  String // JSON
  preliminarySignals  String // JSON

  // Pricing — calculated deterministically server-side at submission time
  // from the MODUS Pricing Model V1 (src/lib/pricing/engine.ts). Never
  // overwritten by a later human review; reviewedEstimate*/finalProposal*
  // are separate fields precisely so the original automatic estimate stays
  // auditable against the pricing model version that produced it.
  pricingVersion         String?
  complexityScoreTotal   Int?
  pricingBand            String?
  implementationScope    String?
  calculatedEstimateMin  Int?
  calculatedEstimateMax  Int?
  manualScopeRequired    Boolean @default(false)
  pricingReasoning       String? // JSON array of internal-facing strings
  // Qualitative levels only (low/moderate/high per dimension), JSON —
  // the customer-facing "why this range" explanation reads from this, not
  // by re-running the engine or exposing internal score numbers/weights.
  pricingFactors         String?

  // A high-entropy, purpose-built public capability token (NOT the row's
  // own id/cuid — a cuid is unique but not designed as an unguessable
  // secret, and reusing it would let anyone who ever saw an admin URL read
  // this customer's profile back). Given to the browser once at submission
  // time, stored in localStorage, and used by GET /api/context/[token] to
  // resolve "does this visitor already have a MODUS profile" without any
  // login. Null for diagnostics submitted before this existed.
  contextToken           String? @unique

  // Set later, from /private, once a human has reviewed the Diagnostic.
  // Kept separate from the calculated* fields above by design.
  reviewedEstimateMin    Int?
  reviewedEstimateMax    Int?
  finalProposalAmount    Int?
  finalProposalNote      String?
  // One-time implementation fee, kept separate from the monthly
  // finalProposalAmount — see PRICING_CONFIG.initialImplementation
  // (indicative €500-2,500, never shown publicly, admin-only by design).
  finalImplementationFee Int?

  // Set only by the admin "Send Proposal" action (never by the client
  // patch schema accepting an arbitrary date) — gates GET /proposal/[token]:
  // a draft finalProposalAmount is never visible at that public URL until
  // this is explicitly set. Re-sending updates it, doesn't require it to
  // be null first.
  proposalSentAt DateTime?

  // Source tracking
  source    String? // e.g. "Homepage", "Chatbot", "Direct"
  referrer  String?
  utmSource String?
  utmMedium String?
  utmCampaign String?

  notes           Note[]
  activityEvents  ActivityEvent[]

  @@index([status])
  @@index([createdAt])
  @@index([email])
  @@index([ownerId])
  @@index([lifecycle])
}

/// Application profile, keyed by Clerk subject id.
///
/// Clerk owns identity; this holds only what the application itself needs.
/// Created on demand at first authenticated use rather than depending on a
/// webhook having already arrived — a delayed webhook must not make a
/// first sign-in fail.
model Profile {
  id        String   @id // Clerk user id
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  email       String?
  displayName String?
  companyName String?

  @@index([email])
}

/// Server-controlled MODUS administrator membership.
///
/// Deliberately its own table, not a field on Profile and not a Clerk
/// metadata claim: metadata is editable from places a browser can reach,
/// and a long-lived token claim cannot be revoked immediately. Every
/// protected request re-checks this table, so removing a row takes effect
/// on the very next action.
///
/// Authentication is never an admin check. Signup grants nothing here.
model AdminMember {
  id        String   @id @default(cuid())
  userId    String   @unique // Clerk user id
  createdAt DateTime @default(now())
  createdBy String? // who granted it, for audit
  revokedAt DateTime?

  @@index([userId])
}

/// Explicit client/workspace access. Separate from AdminMember on purpose:
/// an organisation admin is not a platform-wide MODUS administrator, and a
/// free account holder is neither.
model ClientEntitlement {
  id        String   @id @default(cuid())
  userId    String // Clerk user id
  scope     String // e.g. workspace or account identifier
  createdAt DateTime @default(now())
  revokedAt DateTime?

  @@unique([userId, scope])
  @@index([userId])
}

/// Durable outbox for internal notification email.
///
/// A row is written only AFTER the submission is committed, so a mail
/// failure can never make a saved submission look like it failed, and can
/// never lose the lead. `dedupeKey` is unique, so retries and duplicate
/// events resolve to one delivery.
model NotificationOutbox {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  kind       String // e.g. "diagnostic.submitted"
  dedupeKey  String @unique
  recipient  String
  subject    String
  /// The plain-text part. Required: every mail has one, and rows written
  /// before the HTML part existed have only this.
  body       String
  /// The HTML part, rendered at enqueue time so a retry sends the message
  /// that was composed then rather than re-rendering against a record that
  /// may have moved on. Null for rows from before HTML mail, which still
  /// send correctly as text.
  html       String?
  /// Where a reply should go — the customer for an internal notification,
  /// MODUS for a customer confirmation. Never used as the From address.
  replyTo    String?

  /// The provider's own id for the accepted message, read from the send
  /// response. Without it a send cannot be looked up afterwards, which is
  /// exactly the position the 4 October investigation was in: five
  /// accepted sends and no way to ask the provider what became of any of
  /// them. Null for rows accepted before this was recorded.
  providerMessageId String?

  /// What is actually KNOWN about delivery, as opposed to acceptance.
  ///
  ///   null        nothing known beyond the queue state
  ///   ACCEPTED    the provider took it. Nothing more. This is what a
  ///               2xx on send proves, and it is all it proves.
  ///   DELIVERED   the receiving server accepted it — still not proof it
  ///               reached an inbox rather than a quarantine or a spam
  ///               folder.
  ///   BOUNCED / COMPLAINED / SUPPRESSED
  ///               the provider reported it did not, or will not, arrive.
  ///
  /// Only a provider event or a deliberate lookup may set anything beyond
  /// ACCEPTED. The dispatcher must never write DELIVERED, because it does
  /// not know.
  deliveryState   String?
  /// When `deliveryState` was last established.
  deliveryStateAt DateTime?

  /// The QUEUE state, and only that: PENDING, SENT, FAILED.
  ///
  /// `SENT` means the provider accepted the message and we stopped
  /// retrying. It does NOT mean the message was delivered, and it
  /// certainly does not mean it reached an inbox — a suppressed recipient
  /// is accepted with a 2xx and then silently not delivered, which is how
  /// five internal notifications could all read `SENT` while none arrived.
  /// Confirmed delivery lives in `deliveryState`, which only provider
  /// events can set.
  status     String @default("PENDING") // PENDING, SENT, FAILED
  attempts   Int    @default(0)
  lastError  String?
  sentAt     DateTime?
  nextAttemptAt DateTime?

  @@index([status, nextAttemptAt])
}

/// Single-use, short-lived proof that the bearer may claim a guest
/// diagnostic. Typing the same email address is NOT proof of ownership.
model GuestClaimToken {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now())
  /// SHA-256 of the token. The token itself is never stored, so a database
  /// read cannot be replayed as a claim.
  tokenHash    String   @unique
  diagnosticId String
  expiresAt    DateTime
  consumedAt   DateTime?
  consumedBy   String? // Clerk user id

  @@index([diagnosticId])
  @@index([expiresAt])
}

/// Append-only audit of consequential administrative actions.
/// Deliberately records WHAT changed, never the full answers or secrets.
/// A deletion of a Diagnostic, recorded so it cannot be lost.
///
/// Written by a database TRIGGER, not by application code, so a deletion
/// made from the SQL editor or any future code path is recorded too — and
/// so the audit row and the deletion commit in one transaction or not at
/// all. Production records have twice vanished with no trace; this is what
/// closes that.
///
/// Deliberately NOT related to `Diagnostic`. It has to survive the row it
/// describes, so there is no foreign key for a cascade to follow.
///
/// Holds no answers, no contact details and no capability token: the id,
/// the actor and the time answer "who deleted what, and when" without
/// keeping a copy of data the deletion may have been meant to erase.
///
/// The trigger and its function live in
/// `20261004220000_diagnostic_deletion_audit` — Prisma does not manage
/// either, so that migration is the source of truth for them.
model DiagnosticDeletion {
  id           String   @id @default(uuid())
  deletedAt    DateTime @default(now())
  diagnosticId String
  /// Clerk user id, when the deleting session identified itself.
  actorId      String?
  /// The database role. Always present.
  dbRole       String
  /// 'admin-api', or 'unknown' when the caller did not say.
  source       String

  @@index([deletedAt])
  @@index([diagnosticId])
}

model AuditEvent {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  actorId   String? // Clerk user id
  action    String
  subjectId String?
  detail    String?

  @@index([createdAt])
  @@index([actorId])
}

model Note {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now())
  diagnosticId String
  diagnostic   Diagnostic @relation(fields: [diagnosticId], references: [id], onDelete: Cascade)
  author       String   @default("Admin")
  body         String

  @@index([diagnosticId])
}

model ActivityEvent {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now())
  diagnosticId String
  diagnostic   Diagnostic @relation(fields: [diagnosticId], references: [id], onDelete: Cascade)
  label        String

  @@index([diagnosticId])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  ip        String
  success   Boolean

  @@index([ip, createdAt])
}
